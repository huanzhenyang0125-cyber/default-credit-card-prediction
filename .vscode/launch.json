{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open research dashboard",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.address=127.0.0.1", "--server.port=8502", "--server.headless=false"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
